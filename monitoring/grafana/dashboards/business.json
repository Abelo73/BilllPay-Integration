        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Checkout conversion",
      "description": "Orders placed in the range that ended up paid",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT (count(*) FILTER (WHERE o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED')))::float / nullif(count(*), 0) AS \"Paid ÷ placed\" FROM orders o WHERE $env AND $__timeFilter(o.created_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.9
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Refunded",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT coalesce(sum(r.amount), 0) AS \"Refunded\" FROM refunds r JOIN orders o ON o.id = r.order_id WHERE $env AND r.status = 'SUCCEEDED' AND $__timeFilter(r.created_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ETB",
