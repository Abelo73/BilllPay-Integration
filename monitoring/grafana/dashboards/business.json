    {
      "id": 4,
      "type": "stat",
      "title": "Average order",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 4,
