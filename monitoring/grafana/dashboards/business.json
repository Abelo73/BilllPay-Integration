{
  "uid": "tenashop-business",
  "title": "TenaShop · Business",
  "description": "Revenue, orders, products, delivery and stock, straight from the shop database",
  "tags": [
    "tenashop",
    "business",
    "sql"
  ],
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "1m",
  "timezone": "browser",
  "graphTooltip": 1,
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "env",
        "label": "BillPay",
        "hide": 0,
        "skipUrlSync": false,
        "query": "All : true,Sandbox : o.environment = 'SANDBOX',Live : o.environment = 'LIVE'",
        "current": {
          "text": "All",
          "value": "true",
          "selected": true
        },
        "options": [
          {
            "text": "All",
            "value": "true",
            "selected": true
          },
          {
            "text": "Sandbox",
            "value": "o.environment = 'SANDBOX'",
            "selected": false
          },
          {
            "text": "Live",
            "value": "o.environment = 'LIVE'",
            "selected": false
          }
        ],
        "description": "Sandbox = test money, Live = real money"
      },
      {
        "type": "custom",
        "name": "bucket",
        "label": "Group by",
        "hide": 0,
        "skipUrlSync": false,
        "query": "1h,1d,1w",
        "current": {
          "text": "1d",
          "value": "1d",
          "selected": true
        },
        "options": [
          {
            "text": "1h",
            "value": "1h",
            "selected": false
          },
          {
            "text": "1d",
            "value": "1d",
            "selected": true
          },
          {
            "text": "1w",
            "value": "1w",
            "selected": false
          }
        ]
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "name": "Annotations & Alerts",
        "type": "dashboard",
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)"
      },
      {
        "name": "Backend restarts",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "orange",
        "step": "60s",
        "titleFormat": "Backend restarted",
        "textFormat": "",
        "tagKeys": "",
        "useValueForTime": false,
        "expr": "(time() - process_start_time_seconds{job=\"tenashop-backend\"}) < 90"
      },
      {
        "name": "Alerts firing",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "enable": true,
        "iconColor": "red",
        "step": "60s",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}} {{name}}{{reason}}",
        "tagKeys": "severity",
        "useValueForTime": false,
        "expr": "ALERTS{alertstate=\"firing\"}"
      }
    ]
  },
  "links": [
    {
      "title": "Business",
      "type": "link",
      "url": "/d/tenashop-business",
      "icon": "dashboard"
    },
    {
      "title": "Payments",
      "type": "link",
      "url": "/d/tenashop-payments",
      "icon": "dashboard"
    },
    {
      "title": "Webhooks & Kafka",
      "type": "link",
      "url": "/d/tenashop-webhooks",
      "icon": "dashboard"
    },
    {
      "title": "App",
      "type": "link",
      "url": "/d/tenashop-app",
      "icon": "dashboard"
    },
    {
      "title": "Uptime & Alerts",
      "type": "link",
      "url": "/d/tenashop-uptime",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Selected time range",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Revenue",
      "description": "Totals of orders paid in the range (incl. delivery fee, after discounts)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT coalesce(sum(o.total), 0) AS \"Revenue\" FROM orders o WHERE $env AND o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED') AND $__timeFilter(o.paid_at)",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ETB",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto"
      }
    },
    {
