      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT avg(o.total) AS \"Average order\" FROM orders o WHERE $env AND o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED') AND $__timeFilter(o.paid_at)",
