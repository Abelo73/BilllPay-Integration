      },
      "panels": []
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Revenue",
      "description": "Grouped by the \"Group by\" dropdown (UTC buckets)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(o.paid_at, $bucket), sum(o.total) AS \"Revenue\" FROM orders o WHERE $env AND o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED') AND $__timeFilter(o.paid_at) GROUP BY 1 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ETB",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Orders placed, by outcome",
      "description": "Where each order placed in that bucket is now: PAID, EXPIRED, CANCELLED, ...",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 12,
        "y": 6,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT $__timeGroupAlias(o.created_at, $bucket), o.status AS metric, count(*) AS value FROM orders o WHERE $env AND $__timeFilter(o.created_at) GROUP BY 1, 2 ORDER BY 1",
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 2,
            "fillOpacity": 80,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            },
            "axisSoftMin": 0
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 11,
      "type": "row",
      "title": "Products and payments",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 12,
      "type": "table",
      "title": "Top products",
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 10,
        "h": 9
      },
      "transformations": [],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Revenue"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: ETB"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT i.product_name AS \"Product\", sum(i.quantity) AS \"Units\", sum(i.line_total) AS \"Revenue\" FROM order_items i JOIN orders o ON o.id = i.order_id WHERE $env AND o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED') AND $__timeFilter(o.paid_at) GROUP BY 1 ORDER BY 3 DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "piechart",
      "title": "Paid by method",
      "gridPos": {
        "x": 10,
        "y": 15,
        "w": 7,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "pieType": "donut",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        },
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ],
          "showLegend": true
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT coalesce(p.payment_method, 'unknown') AS \"Method\", count(*) AS \"Paid\" FROM payment_attempts p JOIN orders o ON o.id = p.order_id WHERE $env AND p.status = 'SUCCEEDED' AND $__timeFilter(p.updated_at) GROUP BY 1 ORDER BY 2 DESC",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "type": "bargauge",
      "title": "Why payments did not go through",
      "description": "BillPay's reason code, or the status when there is none (EXPIRED = never paid)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 17,
        "y": 15,
        "w": 7,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT coalesce(p.reason_code, p.status) AS \"Reason\", count(*) AS \"Payments\" FROM payment_attempts p JOIN orders o ON o.id = p.order_id WHERE $env AND p.status IN ('FAILED', 'EXPIRED', 'CANCELLED', 'ERROR') AND $__timeFilter(p.updated_at) GROUP BY 1 ORDER BY 2 DESC LIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": true
        }
      }
    },
    {
      "id": 15,
      "type": "row",
      "title": "Delivery and stock",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 16,
      "type": "stat",
      "title": "To fulfil now",
      "description": "Paid orders not shipped yet (right now, ignores the time range)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT count(*) AS \"To fulfil\" FROM orders o WHERE $env AND o.status = 'PAID' AND coalesce(o.fulfilment_status, 'UNFULFILLED') IN ('UNFULFILLED', 'PROCESSING')",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
