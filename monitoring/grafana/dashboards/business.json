    {
      "id": 28,
      "type": "bargauge",
      "title": "Checkout funnel",
      "description": "Orders placed in the range and how far they got. \"Tried to pay\" = BillPay reported a try (paid or declined).",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "tenashop-db"
      },
      "gridPos": {
        "x": 0,
        "y": 54,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "tenashop-db"
          },
          "rawSql": "SELECT step AS \"Step\", n AS \"Orders\" FROM (\n  SELECT 1 AS k, '1 · Placed' AS step, count(*) AS n FROM orders o WHERE $env AND $__timeFilter(o.created_at)\n  UNION ALL SELECT 2, '2 · BillPay link created', count(*) FROM orders o WHERE $env AND $__timeFilter(o.created_at)\n    AND EXISTS (SELECT 1 FROM order_events e WHERE e.order_id = o.id AND e.type = 'PAYMENT_REQUESTED')\n  UNION ALL SELECT 3, '3 · Tried to pay', count(*) FROM orders o WHERE $env AND $__timeFilter(o.created_at)\n    AND EXISTS (SELECT 1 FROM order_events e WHERE e.order_id = o.id AND e.type IN ('PAYMENT_TRY_FAILED', 'PAYMENT_FAILED', 'PAID'))\n  UNION ALL SELECT 4, '4 · Paid', count(*) FROM orders o WHERE $env AND $__timeFilter(o.created_at) AND o.status IN ('PAID', 'PARTIALLY_REFUNDED', 'REFUNDED')\n) f ORDER BY k",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "continuous-BlPu"
          },
          "min": 0
        },
        "overrides": []
