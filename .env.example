# Copy to .env and fill in. Never commit .env.

# ---- Ports (non-default) ----
POSTGRES_HOST_PORT=5544
BACKEND_PORT=8181
KAFKA_HOST_PORT=29492
KAFKA_UI_PORT=8191
FRONTEND_PORT=5280

# ---- Database ----
POSTGRES_DB=tenashop
POSTGRES_USER=tenashop
POSTGRES_PASSWORD=change-me

# ---- BillPay ----
# Both sets of keys live here side by side. To switch, use Admin → BillPay setup → "Payment mode"
# (takes effect at once, no restart). BILLPAY_MODE is only the starting mode until an admin picks one.
BILLPAY_MODE=SANDBOX

# Sandbox (test money): BillPay dashboard with the "Test" toggle → Developers
BILLPAY_SANDBOX_BASE_URL=https://sandbox.api.billpay.et
BILLPAY_SANDBOX_API_KEY=BPG_TEST-replace-me
BILLPAY_SANDBOX_WEBHOOK_SECRET=

# Live (real money): same dashboard with the "Live" toggle. Live mode stays locked until the key and
# webhook secret are set, signatures are enforced, and no admin uses a well-known password.
BILLPAY_LIVE_BASE_URL=https://api.billpay.et
BILLPAY_LIVE_API_KEY=
BILLPAY_LIVE_WEBHOOK_SECRET=

# Shared: BillPay signs as X-Billpay-Signature: t=<ts>,v1=<hex HMAC-SHA256 of "<ts>.<body>">
# NONE is accepted for sandbox experiments only
BILLPAY_WEBHOOK_VERIFICATION=HMAC_SHA256
BILLPAY_WEBHOOK_SIGNATURE_HEADER=X-Billpay-Signature
BILLPAY_TIMEOUT_MS=10000

# ---- App URLs ----
APP_PUBLIC_BASE_URL=http://localhost:5280
# BillPay requires https return/cancel URLs: use your ngrok URL (it forwards to the backend)
APP_REDIRECT_BASE_URL=https://vocalize-porridge-cogwheel.ngrok-free.dev
# Tunnel: ngrok http --url=vocalize-porridge-cogwheel.ngrok-free.dev 8181
APP_WEBHOOK_PUBLIC_URL=https://vocalize-porridge-cogwheel.ngrok-free.dev/api/webhooks/billpay

# ---- Payments ----
RECONCILE_AFTER=PT3M
PAYMENT_EXPIRY=PT30M
# One "finish paying" email this long before an unpaid order expires (PT0S turns it off)
PAYMENT_REMINDER_BEFORE=PT10M

# ---- Admin ----
ADMIN_EMAIL=admin@tenashop.local
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-32-plus-random-bytes

# ---- Product photos (S3-compatible: SeaweedFS in Docker; AWS S3 / R2 later) ----
MEDIA_S3_HOST_PORT=9910
MEDIA_UI_PORT=9911
MEDIA_S3_ENDPOINT=http://localhost:9910
MEDIA_S3_BUCKET=tenashop-media
MEDIA_S3_ACCESS_KEY=tenashop
MEDIA_S3_SECRET_KEY=change-me-to-a-random-secret

# ---- Delivery (ETB): flat fee, free from this cart subtotal ----
DELIVERY_FLAT_FEE=150
DELIVERY_FREE_OVER=3000

# ---- Monitoring: Prometheus (alerts) and Grafana (dashboards) ----
PROMETHEUS_PORT=9390
GRAFANA_PORT=8484
GRAFANA_ADMIN_PASSWORD=change-me
# Read-only DB user Grafana uses for the Business dashboard (created by the grafana-db-init service)
GRAFANA_DB_PASSWORD=change-me-grafana-reader
# Alert notifications (emails go to Mailpit in dev) and the outside-check exporter
ALERTMANAGER_PORT=9393
BLACKBOX_PORT=9395

# ---- Customer emails (Mailpit in Docker catches them locally; open the inbox in the browser) ----
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=2626
MAILPIT_UI_PORT=8626
MAIL_INBOX_URL=http://localhost:8626
MAIL_FROM=Sodo Gebeya <orders@sodogebeya.local>

# ---- SMS (AfroMessage) ----
# Leave AFROMESSAGE_TOKEN empty for test mode: SMS go to the backend log and Admin → SMS instead of phones.
# Token: app.afromessage.com → API keys. Identifier id and sender name: Identifiers (sender name needs approval).
AFROMESSAGE_TOKEN=
AFROMESSAGE_IDENTIFIER_ID=
AFROMESSAGE_SENDER=
# Local development only: show sign-in codes on screen while in test mode (ignored with a real token or BillPay live)
SMS_DEV_CODES_IN_RESPONSE=true
