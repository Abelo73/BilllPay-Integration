# Copy to .env and fill in. Never commit .env.

# ---- Ports (non-default) ----
POSTGRES_HOST_PORT=5544
BACKEND_PORT=8181
KAFKA_HOST_PORT=29492
KAFKA_UI_PORT=8191
FRONTEND_PORT=5280

# ---- Database ----
POSTGRES_DB=tenashop
POSTGRES_USER=tenashop
POSTGRES_PASSWORD=change-me

# ---- BillPay ----
BILLPAY_BASE_URL=https://sandbox.api.billpay.et
BILLPAY_API_KEY=BPG_TEST-replace-me
# NONE (sandbox only, until BillPay confirms its scheme) or HMAC_SHA256
BILLPAY_WEBHOOK_VERIFICATION=NONE
BILLPAY_WEBHOOK_SECRET=
BILLPAY_WEBHOOK_SIGNATURE_HEADER=X-BillPay-Signature
BILLPAY_TIMEOUT_MS=10000

# ---- App URLs ----
APP_PUBLIC_BASE_URL=http://localhost:5280
# BillPay requires https return/cancel URLs: use your ngrok URL (it forwards to the backend)
APP_REDIRECT_BASE_URL=https://vocalize-porridge-cogwheel.ngrok-free.dev
# Tunnel: ngrok http --url=vocalize-porridge-cogwheel.ngrok-free.dev 8181
APP_WEBHOOK_PUBLIC_URL=https://vocalize-porridge-cogwheel.ngrok-free.dev/api/webhooks/billpay

# ---- Payments ----
RECONCILE_AFTER=PT3M
PAYMENT_EXPIRY=PT30M

# ---- Admin ----
ADMIN_EMAIL=admin@tenashop.local
ADMIN_PASSWORD=change-me
JWT_SECRET=replace-with-32-plus-random-bytes

# ---- Product photos (S3-compatible: SeaweedFS in Docker; AWS S3 / R2 later) ----
MEDIA_S3_HOST_PORT=9910
MEDIA_UI_PORT=9911
MEDIA_S3_ENDPOINT=http://localhost:9910
MEDIA_S3_BUCKET=tenashop-media
MEDIA_S3_ACCESS_KEY=tenashop
MEDIA_S3_SECRET_KEY=change-me-to-a-random-secret

# ---- Delivery (ETB): flat fee, free from this cart subtotal ----
DELIVERY_FLAT_FEE=150
DELIVERY_FREE_OVER=3000

# ---- Monitoring: Prometheus (alerts) and Grafana (dashboards) ----
PROMETHEUS_PORT=9390
GRAFANA_PORT=3300
GRAFANA_ADMIN_PASSWORD=change-me

# ---- Customer emails (Mailpit in Docker catches them locally; open the inbox in the browser) ----
MAIL_ENABLED=true
MAIL_HOST=localhost
MAIL_PORT=2626
MAILPIT_UI_PORT=8626
MAIL_INBOX_URL=http://localhost:8626
MAIL_FROM=TenaShop <orders@tenashop.local>
